+# =============================================================================
+# NETWORK CO-PROCESSOR - WiFi firmware variant
+# =============================================================================
+# The Waveshare 7B uses an ESP32-C6 co-processor for hosted WiFi 6/BLE over
+# SDIO (slot 1, ESPHome's default). Pins match the JC1060P470 panel.
+# =============================================================================
+
+esp32_hosted:
+  variant: esp32c6
+  reset_pin: GPIO54
+  cmd_pin: GPIO19
+  clk_pin: GPIO18
+  d0_pin: GPIO14
+  d1_pin: GPIO15
+  d2_pin: GPIO16
+  d3_pin: GPIO17
+  active_high: true
+  sdio_frequency: 20MHz
diff --git a/devices/waveshare-esp32-p4-wifi6-touch-lcd-7b/device/sensors.yaml b/devices/waveshare-esp32-p4-wifi6-touch-lcd-7b/device/sensors.yaml
